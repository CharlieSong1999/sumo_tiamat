<mujoco model="spot_pit">
  <!-- Spot + pit water pitcher scene. Mirrors spot_bucket.xml; object and grasp sensor differ.
       The pit's water balls (plant variant) are appended programmatically by the plant task
       (SpotPitMovePlant / SpotPitPourPlant) AFTER everything else, so the shared robot/object
       state prefix is index-identical between the planner and plant models. -->
  <include file="../spot_components/default.xml"/>
  <include file="../spot_components/assets.xml"/>

  <worldbody>
    <light directional="true" diffuse=".4 .4 .4" specular="0.1 0.1 0.1" pos="0 0 5" dir="0 0 -1" castshadow="false"/>
    <light directional="true" diffuse=".6 .6 .6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1"/>

    <geom name="ground" type="plane" size="10 10 0.01" class="collision" priority="5" friction="0.7" material="blue_grid"/>

    <body name="body" pos="0 0 0.7">
      <include file="../spot_components/body.xml"/>
      <include file="../spot_components/legs.xml"/>
      <include file="../spot_components/arm.xml"/>
    </body>
  </worldbody>

  <include file="../objects/pit/pit.xml"/>

  <include file="../spot_components/actuator.xml"/>
  <include file="../spot_components/sensor.xml"/>
  <include file="../spot_components/contact.xml"/>

  <sensor>
    <!-- Robot base + foot sensors (for the locomotion backend; identical to spot_bucket.xml). -->
    <framepos name="base_position" objtype="site" objname="site_body"/>
    <framexaxis name="base_xaxis" objtype="body" objname="body"/>
    <frameyaxis name="base_yaxis" objtype="body" objname="body"/>
    <framezaxis name="base_zaxis" objtype="body" objname="body"/>

    <framepos name="fl_pos" objtype="site" objname="site_front_left"/>
    <framepos name="fr_pos" objtype="site" objname="site_front_right"/>
    <framepos name="hl_pos" objtype="site" objname="site_rear_left"/>
    <framepos name="hr_pos" objtype="site" objname="site_rear_right"/>

    <subtreecom name="base_subtreecom" body="body"/>
    <subtreelinvel name="base_subtreelinvel" body="body"/>
    <subtreeangmom name="base_angmom" body="body"/>

    <framepos name="trace_body" objtype="site" objname="site_body"/>
    <framepos name="trace_fngr_site" objtype="site" objname="site_arm_link_fngr"/>
    <framepos name="trace_pit" objtype="site" objname="trace_pit"/>

    <!-- Object orientation: x-axis from body; y/z-axis come from shared sensor.xml (on site_object). -->
    <framexaxis name="object_x_axis" objtype="body" objname="pit"/>

    <!-- Gripper (fngr = pinch point) to the handle grasp point (vertical outer bar). -->
    <framepos name="sensor_gripper_to_grasp_handle" objtype="site" objname="site_arm_link_wr1" reftype="site" refname="site_grasp_handle"/>

    <!-- Gripper (fngr) to the hook point (loop-opening center, under the top riser). -->
    <framepos name="sensor_gripper_to_hook" objtype="site" objname="site_arm_link_fngr" reftype="site" refname="site_hook"/>

    <!-- Gripper (fngr) to the alternative pour-grasp targets. -->
    <framepos name="sensor_gripper_to_wall" objtype="site" objname="site_arm_link_wr1" reftype="site" refname="site_grasp_wall"/>
    <framepos name="sensor_gripper_to_inside" objtype="site" objname="site_arm_link_wr1" reftype="site" refname="site_grasp_inside"/>

    <!-- Gripper orientation. -->
    <framexaxis name="sensor_gripper_x_axis" objtype="site" objname="site_arm_link_wr1"/>
    <frameyaxis name="sensor_gripper_y_axis" objtype="site" objname="site_arm_link_wr1"/>
    <framezaxis name="sensor_gripper_z_axis" objtype="site" objname="site_arm_link_wr1"/>

    <!-- Torso to approach sites (three, like spot_bucket.xml). -->
    <framepos name="sensor_torso_to_approach_left" objtype="site" objname="site_body" reftype="site" refname="site_approach_left"/>
    <framepos name="sensor_torso_to_approach_mid" objtype="site" objname="site_body" reftype="site" refname="site_approach_mid"/>
    <framepos name="sensor_torso_to_approach_right" objtype="site" objname="site_body" reftype="site" refname="site_approach_right"/>
  </sensor>
</mujoco>
