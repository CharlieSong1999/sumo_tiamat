<mujoco model="bucket_defs">
  <!-- Asset + style declarations for the bucket-with-handle object. -->
  <default>
    <default class="visual_bucket">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="collision_bucket">
      <geom priority="6" group="3" friction="0.6 0.3 0.2"/>
    </default>
  </default>

  <asset>
    <material name="bucket_material" rgba="0.2 0.5 0.7 1"/>
    <!-- Imported mesh is ~2.0 units tall (along local Y = up-axis). scale=0.22 -> ~0.44 m total height
         (bucket body ~0.34 m tall / ~0.28 m dia, bail handle arcs ~0.10 m above the rim). -->
    <mesh name="bucket_mesh" file="../../../meshes/bucket/model.obj" scale="0.22 0.22 0.22"/>
  </asset>
</mujoco>
