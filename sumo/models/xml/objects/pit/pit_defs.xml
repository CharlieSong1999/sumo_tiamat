<mujoco model="pit_defs">
  <!-- Asset + style declarations for the "pit" water container (a clear rectangular
       pitcher with a side handle and a pour spout, generated by Meshy AI).

       Raw mesh frame is Y-up, ~1.55 x 0.85 footprint x 2.0 tall units, handle on +X,
       spout lip on -X. scale=0.2 -> ~0.40 m tall, interior cavity ~0.21 x 0.13 x 0.38 m
       (~10 L when full). The material is semi-transparent so the water-ball fill level
       is visible from outside ("clear" pitcher). -->
  <default>
    <default class="visual_pit">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="collision_pit">
      <geom priority="6" group="3" friction="0.6 0.005 0.0001"/>
    </default>
    <default class="water_ball">
      <!-- Sphere "water particles". condim=1 (frictionless) lets the pile shear and
           level out like a liquid; density 1560 kg/m^3 gives bulk density ~1000 (water)
           at random-close-packing fraction ~0.64. priority=7 beats the container's
           priority=6 so ball contacts keep the frictionless condim. -->
      <geom type="sphere" size="0.015" density="1560" condim="1" priority="7"
            rgba="0.25 0.55 0.95 0.85" group="2"/>
    </default>
  </default>

  <asset>
    <!-- Plain translucent material ("clear" plastic look; the bundled PNG texture renders
         too dark under the sim lights and hides the fill level). -->
    <material name="pit_material" rgba="0.75 0.82 0.9 0.45" specular="0.6" shininess="0.6"/>
    <mesh name="pit_mesh" file="../../../meshes/pit/Meshy_AI_Clear_rectangular_pit_0702061242_texture.obj" scale="0.2 0.2 0.2"/>
  </asset>
</mujoco>
